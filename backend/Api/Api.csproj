<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.6" />

    <!--
      GHIM 2.13.0, ĐỪNG NÂNG LÊN 3.x.

      2.0.0 có lỗ hổng mức cao (NU1903), nên phải nâng. Nhưng 3.x đổi
      `IOpenApiMediaType.Example` thành chỉ-đọc, và source generator của
      Microsoft.AspNetCore.OpenApi vẫn gán vào nó — build vỡ với CS0200
      trong mã SINH RA, không phải mã của dự án, nên không sửa được từ đây.
      2.13.0 là bản đã vá lỗ hổng mà còn tương thích.

      Kiểm lại sau khi nâng Microsoft.AspNetCore.OpenApi, bằng
      `dotnet list package` với cờ `vulnerable` và `include-transitive`.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />

    <!-- Ghim để NU1902 (mức vừa) ở 2.4.0 không quay lại qua phụ thuộc gián
         tiếp của Pomelo. -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

</Project>
